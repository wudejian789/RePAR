{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "tool_calls": {
      "type": "array", "minItems": 0, "maxItems": 3,
      "items": {
        "anyOf": [
          {"type":"object","additionalProperties":false,"required":["name","parameters"],"properties":{
            "name":{"const":"tree_search"},"parameters":{"type":"object","additionalProperties":false,"required":["query"],"properties":{
              "query":{"type":"string","minLength":1,"maxLength":180},"top_k":{"type":"integer","minimum":1,"maximum":24},
              "scope":{"type":"string","maxLength":12},"beam_width":{"type":"integer","minimum":1,"maximum":32},"mode":{"enum":["hybrid","tree"]}}}}},
          {"type":"object","additionalProperties":false,"required":["name","parameters"],"properties":{
            "name":{"const":"graph_search"},"parameters":{"type":"object","additionalProperties":false,"required":["query"],"properties":{
              "query":{"type":"string","minLength":1,"maxLength":180},"top_k":{"type":"integer","minimum":1,"maximum":24},
              "seeds":{"type":"array","maxItems":12,"items":{"type":"string","maxLength":12}},
              "hops":{"type":"integer","minimum":1,"maximum":3},
              "relations":{"type":"array","minItems":1,"maxItems":4,"items":{"enum":["shared_entity","shared_concept","semantic_related","sequence"]}}}}}},
          {"type":"object","additionalProperties":false,"required":["name","parameters"],"properties":{
            "name":{"const":"read"},"parameters":{"type":"object","additionalProperties":false,"required":["ids"],"properties":{
              "ids":{"type":"array","minItems":1,"maxItems":12,"items":{"type":"string","maxLength":12}},
              "radius":{"type":"integer","minimum":0,"maximum":2}}}}},
          {"type":"object","additionalProperties":false,"required":["name","parameters"],"properties":{
            "name":{"const":"tree_browse"},"parameters":{"type":"object","additionalProperties":false,"required":["node"],"properties":{
              "node":{"type":"string","minLength":1,"maxLength":12},"top_k":{"type":"integer","minimum":1,"maximum":24}}}}}
        ]
      }
    },
    "finish": {"type":"boolean"},
    "reflection": {"type":"string","maxLength":220},
    "plan": {"type":"string","maxLength":220},
    "policy_update": {"type":"object","additionalProperties":false,"required":["focus","strategy"],"properties":{
      "focus":{"type":"string","maxLength":160},"strategy":{"type":"string","maxLength":160}}}
  },
  "required": ["tool_calls","finish","reflection","plan","policy_update"]
}
