# Python and build outputs
__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

# Local credentials, editor state and runtime files
.env
.env.*
!.env.example
*.local.json
*.pem
*.key
*.log
*.pid
*.tmp
.idea/
.vscode/
/other_server_usage.md

# Model weights stay local; retain provenance manifests.
/models/**
!/models/**/
!/models/**/source_manifest.json
!/models/**/download_manifest.json

# Raw benchmarks and textbooks stay local.
/data/**
!/data/**/
!/data/**/README.md
!/data/**/LICENSE*
!/data/repo.json
!/data/dataset_readme.md

